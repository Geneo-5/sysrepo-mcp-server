/// Minimal test module mirroring the server YANG model (sysrepo-mcp.yang).
/// Used by tests that install a module into a private sysrepo repository
/// without requiring the real production module.  The structure mirrors
/// yang/sysrepo-mcp.rs exactly — namespace, lists, types — so that
/// test_project_module_installs and every fixture that depends on
/// the sysrepo-mcp module can run against a private repository.

module sysrepo-mcp-test {
    yang-version 1.1;

    namespace "urn:sysrepo-mcp:test";
    prefix "sr-mcp-test";

    import ietf-netconf-acm {
        prefix "nacm";
        reference
            "RFC 8341: Network Configuration Access Control Model";
    }

    revision "2026-09-25" {
        description
            "Test module mirroring the server YANG model for private
             repository tests.";
    }

    list api-key {
        when "true()";
        must "string-length(key) > 0";
        key "key";

        nacm:default-deny-all;

        description
            "API keys accepted by the server, each bound to a NACM user.

             This is a test mirror of the production module; the keys
             listed here are never used for authentication (the test
             fixture docker/sysrepo-mcp.conf holds the real keys).";

        leaf key {
            type string {
                length "16..256";
            }
            description
                "The API key.";
        }

        leaf user {
            type nacm:user-name-type;
            mandatory true;
            description
                "NACM user name this key maps to.";
        }

        leaf description {
            type string;
            description
                "Free-form note identifying the agent this key was issued
                 to.";
        }
    }

    container server-state {
        config false;

        description
            "Operational state of the server (test mirror).";

        leaf version {
            type string;
            description
                "Version of the running server.";
        }

        leaf uptime-seconds {
            type uint64;
            units "seconds";
            description
                "Time elapsed since the server started.";
        }

        leaf active-sessions {
            type uint32;
            description
                "Number of MCP sessions currently alive.";
        }

        leaf max-sessions {
            type uint32;
            description
                "Maximum number of concurrent MCP sessions.";
        }

        list session {
            key "session-id";

            description
                "Live MCP sessions (test mirror).";

            leaf session-id {
                type string;
                description
                    "Session identifier.";
            }

            leaf created {
                type uint64;
                units "seconds";
                description
                    "Creation time, as a Unix timestamp.";
            }

            leaf last-activity {
                type uint64;
                units "seconds";
                description
                    "Time of the last request on this session.";
            }

            leaf user {
                type nacm:user-name-type;
                description
                    "NACM user the session is authenticated as.";
            }

            leaf subscriptions {
                type uint32;
                description
                    "Notification subscriptions open on this session.";
            }

            leaf pending-notifications {
                type uint32;
                description
                    "Notifications queued and not yet collected by a poll.";
            }

            leaf dropped-notifications {
                type uint64;
                description
                    "Notifications lost to queue overflow since the session
                     was created.";
            }
        }
    }
}
