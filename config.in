# =============================================================================
# SERVER
# Configuration options that affect runtime behavior are in yang/sysrepo-mcp.yang
# =============================================================================

config SYSREPO_MCP_SERVER_MAX_SESSIONS
	int
	range 1 1024
	default 64
	help
		Maximum number of concurrent MCP sessions.

		Past this number, initialize is refused with HTTP 503. Each
		session carries its notification subscriptions and its
		notification queue, so this bounds the memory the server can
		be made to hold.

config SYSREPO_MCP_SERVER_SESSION_TTL
	int
	range 60 86400
	default 1800
	help
		Seconds of inactivity after which a session is destroyed,
		along with its subscriptions and its pending notifications.

		A client whose session expired gets HTTP 404 and is expected
		to call initialize again.

config SYSREPO_MCP_SERVER_NOTIF_QUEUE_SIZE
	int
	range 8 65536
	default 256
	help
		Notifications buffered per session between two polls.

		When the queue is full the oldest entry is dropped and the
		count is reported by sr_notif_poll, so an agent polling too
		slowly is told rather than silently missing events.

# =============================================================================
# FASTCGI TRANSPORT
# =============================================================================

choice
	prompt "FastCGI transport mode"
	default SYSREPO_MCP_SERVER_TRANSPORT_UNIX

	config SYSREPO_MCP_SERVER_TRANSPORT_UNIX
		bool
		prompt "Unix socket (local only)"

	config SYSREPO_MCP_SERVER_TRANSPORT_TCP
		bool
		prompt "TCP (remote or proxied)"

endchoice

config SYSREPO_MCP_SERVER_UNIX_SOCKET_PATH
	string
	default "/var/run/sysrepo-mcp.sock"
	depends on SYSREPO_MCP_SERVER_TRANSPORT_UNIX
	help
		Unix socket path for FastCGI (when using Unix socket transport)

config SYSREPO_MCP_SERVER_TCP_HOST
	string
	default "127.0.0.1"
	depends on SYSREPO_MCP_SERVER_TRANSPORT_TCP
	help
		TCP host to bind for FastCGI (when using TCP transport)

config SYSREPO_MCP_SERVER_TCP_PORT
	int
	range 1 65535
	default 8080
	depends on SYSREPO_MCP_SERVER_TRANSPORT_TCP
	help
		TCP port to bind for FastCGI (when using TCP transport)

# =============================================================================
# ACCESS CONTROL
# Runtime configuration options are in yang/sysrepo-mcp.yang
# =============================================================================

config SYSREPO_MCP_SERVER_ACL_ENABLED
	bool
	default y
	help
		Enable access control (authentication + NACM)

choice
	prompt "Credential type"
	default SYSREPO_MCP_SERVER_AUTH_BEARER

	config SYSREPO_MCP_SERVER_AUTH_BEARER
		bool
		prompt "Authorization: Bearer <key>"

	config SYSREPO_MCP_SERVER_AUTH_COOKIE
		bool
		prompt "Cookie <name>=<key>"

endchoice

config SYSREPO_MCP_SERVER_COOKIE_NAME
	string
	default "mcp_session"
	depends on SYSREPO_MCP_SERVER_AUTH_COOKIE
	help
		Cookie name for session authentication

config SYSREPO_MCP_SERVER_ACL_ENABLE_NACM
	bool
	default y
	depends on SYSREPO_MCP_SERVER_ACL_ENABLED
	help
		Enable sysrepo NACM integration for fine-grained access control

config SYSREPO_MCP_SERVER_ACL_ENABLE_MODULE_FILTER
	bool
	default y
	depends on SYSREPO_MCP_SERVER_ACL_ENABLED
	help
		Enable module-level access filtering

config SYSREPO_MCP_SERVER_ACL_ENABLE_OPERATION_FILTER
	bool
	default n
	depends on SYSREPO_MCP_SERVER_ACL_ENABLED
	help
		Enable operation-level access filtering (read vs write)

config SYSREPO_MCP_SERVER_ACL_ENABLE_WRITE_PROTECTION
	bool
	default n
	depends on SYSREPO_MCP_SERVER_ACL_ENABLED
	help
		Enable write protection for sensitive modules

config SYSREPO_MCP_SERVER_ACL_ALLOWED_MODULES
	string
	default ""
	help
		Comma-separated list of allowed YANG modules (empty = all)

# =============================================================================
# SYSREPO REPOSITORY
# Note: sysrepo is used as a LIBRARY (linked at build time). There has been no
# sysrepo daemon since version 2, so there is no daemon socket to configure.
# The repository holds the YANG modules and the startup datastore; the running
# datastore lives in POSIX shared memory, not in a file.
# Runtime options are in yang/sysrepo-mcp.yang
# =============================================================================

config SYSREPO_MCP_SERVER_SYSREPO_DATASTORE_DIR
	string
	default "/etc/sysrepo"
	help
		sysrepo repository directory, exported as
		SYSREPO_REPOSITORY_PATH before connecting.

		Note that sysrepo resolves this path at its own compile time
		(-DREPO_PATH) and only honours the environment variable as an
		override. This option cannot move a repository that the linked
		sysrepo build does not agree on.

# =============================================================================
# LOGGING (elog)
# =============================================================================

config SYSREPO_MCP_SERVER_SYSLOG_ENABLED
	bool
	default y
	help
		Enable syslog logging via elog library

config SYSREPO_MCP_SERVER_LOG_LEVEL
	int
	range 0 7
	default 6
	help
		Log level (0=emerg, 1=alert, 2=crit, 3=err, 4=warning, 5=notice, 6=info, 7=debug)

config SYSREPO_MCP_SERVER_LOG_VERBOSE
	bool
	default n
	help
		Enable verbose debugging output

config SYSREPO_MCP_SERVER_LOG_FILE
	string
	default "/var/log/sysrepo-mcp.log"
	depends on !SYSREPO_MCP_SERVER_SYSLOG_ENABLED
	help
		Log file path (used when syslog is disabled)

config SYSREPO_MCP_SERVER_LOG_CONSOLE
	bool
	default y
	help
		Enable console logging (stderr)

	config SYSREPO_MCP_SERVER_SESSION_ID_LEN
		int
		range 16 256
		default 32
		help
			Length of session identifiers in hexadecimal characters.

			A 32-character ID carries 128 bits of entropy from
			/dev/urandom, which is sufficient to prevent guessing.

	config SYSREPO_MCP_SERVER_MAX_TREE_DEPTH
		int
		range 1 128
		default 32
		help
			Maximum depth when walking a YANG schema tree.

			Prevents unbounded recursion on deeply nested schemas.

	config SYSREPO_MCP_SERVER_DEFAULT_TIMEOUT_MS
		int
		range 100 60000
		default 5000
		help
			Default timeout in milliseconds for sysrepo operations
			that accept a timeout argument (apply changes, get data).
