################################################################################
#
# Doxygen configuration for sysrepo-mcp-server.
#
# Doxygen is used here only as an XML front-end for Breathe: it parses the
# public headers of include/ and emits XML that sphinx/conf.py picks up when
# sphinx/_doxygen/xml exists. No HTML, LaTeX or RTF output is produced.
#
# Run from the project root:
#     VERSION=x.y doxygen sphinx/Doxyfile
#
################################################################################

PROJECT_NAME           = "sysrepo-mcp-server"
PROJECT_NUMBER         = $(VERSION)
PROJECT_BRIEF          = "MCP server bridging AI agents and the sysrepo datastore"

OUTPUT_DIRECTORY       = sphinx/_doxygen
OUTPUT_LANGUAGE        = English

################################################################################
# Input
################################################################################

INPUT                  = include
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h
RECURSIVE              = YES

# Strip the leading include/ from the paths shown in the generated XML.
STRIP_FROM_PATH        = include

################################################################################
# Extraction
################################################################################

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
EXTRACT_LOCAL_CLASSES  = YES
HIDE_SCOPE_NAMES       = NO

OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES

################################################################################
# Output formats
#
# Only XML, for Breathe. Everything else is produced by Sphinx.
################################################################################

GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_DOCBOOK       = NO
GENERATE_HTMLHELP      = NO
GENERATE_QHP           = NO

SOURCE_BROWSER         = NO

################################################################################
# Preprocessing
#
# The Kconfig symbols of config.in reach the sources as CONFIG_* macros. They
# are defined here so that doxygen parses every branch of a conditional
# declaration rather than the one a given build happens to select.
################################################################################

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES

PREDEFINED             = CONFIG_SYSREPO_MCP_SERVER_SESSION_ID_LEN=32 \
                         CONFIG_SYSREPO_MCP_SERVER_SYSREPO_DATASTORE_DIR=\"/etc/sysrepo\"

################################################################################
# Diagnostics
################################################################################

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_FORMAT            = "$file:$line: $text"
