# =============================================================================
# SERVER
# Configuration options that affect runtime behavior are in the libconfig
# file (docker/sysrepo-mcp.conf by default), parsed at startup by
# src/libconfig.c. Only build-time toggles belong here.
# =============================================================================

config PACKAGE_NAME
	string
	default "sysrepo-mcp"

config PACKAGE_VERSION
	string "Version"
	default "0.0.0-unknown"


# =============================================================================
# SYSREPO REPOSITORY
# Note: sysrepo is used as a LIBRARY (linked at build time). There has been no
# sysrepo daemon since version 2, so there is no daemon socket to configure.
# The repository holds the YANG modules and the startup datastore; the running
# datastore lives in POSIX shared memory, not in a file.
# Runtime options are in the libconfig file, not in this Kconfig tree.
# =============================================================================

config SYSREPO_MCP_SERVER_SYSREPO_DATASTORE_DIR
	string "Sysrepo repository path"
	default "/etc/sysrepo"
	help
		sysrepo repository directory, exported as
		SYSREPO_REPOSITORY_PATH before connecting.

		Note that sysrepo resolves this path at its own compile time
		(-DREPO_PATH) and only honours the environment variable as an
		override. This option cannot move a repository that the linked
		sysrepo build does not agree on.

config SYSREPO_MCP_SERVER_SESSION_ID_LEN
	int "Session ID length (hex characters)"
	range 16 256
	default 32
	help
		Length of session identifiers in hexadecimal characters.

		A 32-character ID carries 128 bits of entropy from
		/dev/urandom, which is sufficient to prevent guessing.

config SYSREPO_MCP_SERVER_MAX_API_KEY_LEN
	int "Maximum API key length (bytes)"
	range 16 4096
	default 256
	help
		Maximum length, in bytes, of a configured API key.

		API keys stay plaintext in the libconfig file and in process
		memory (no hashing, per project policy). This bounds the
		fixed-width, constant-time lookup used by mcp_config_find_key(),
		and rejects any configured key longer than it at load time.
