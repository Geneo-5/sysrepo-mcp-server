config STRING
        prompt "Listen address"
        default "127.0.0.1"

config INTEGER
        prompt "Listen port"
        default 8080

config BOOL
        prompt "Enable syslog logging"
        default y

config BOOL
        prompt "Enable verbose debugging"
        default n

config STRING
        prompt "Sysrepo socket path"
        default "/var/run/sysrepod.sock"

config STRING
        prompt "MCP server socket path"
        default "/var/run/sysrepo-mcp.sock"
