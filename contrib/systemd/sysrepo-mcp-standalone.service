# Starts sysrepo-mcp directly with its own FastCGI Unix listener.

[Unit]
Description=sysrepo-mcp standalone FastCGI service
After=network.target

[Service]
Type=simple
User=sysrepo-mcp
Group=sysrepo
RuntimeDirectory=sysrepo-mcp
RuntimeDirectoryMode=0750
LogsDirectory=sysrepo-mcp
LogsDirectoryMode=0750
UMask=0007
ExecStart=/usr/local/bin/sysrepo-mcp --config /etc/sysrepo-mcp/sysrepo-mcp-standalone.conf
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/sysrepo /dev/shm /run/sysrepo-mcp /var/log/sysrepo-mcp

[Install]
WantedBy=multi-user.target
