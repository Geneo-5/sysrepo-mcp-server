# =============================================================================
# SERVER
# =============================================================================

config STRING
        default "/mcp"

config INTEGER
        range 60 86400
        default 1800

config INTEGER
        range 1 1024
        default 64

# =============================================================================
# FASTCGI TRANSPORT
# =============================================================================

choice
        prompt "FastCGI transport mode"
        default UNIX_SOCKET

config BOOL
        prompt "Unix socket (local only)"
        default y

config BOOL
        prompt "TCP (remote or proxied)"
        default n

endchoice

config STRING
        default "/var/run/sysrepo-mcp.sock"
        depends on UNIX_SOCKET

config STRING
        default "127.0.0.1"
        depends on TCP

config INTEGER
        range 1 65535
        default 8080
        depends on TCP

# =============================================================================
# ACCESS CONTROL
# =============================================================================

config BOOL
        default y

choice
        prompt "Credential type"
        default API_KEY_BEARER

config BOOL
        prompt "Authorization: Bearer <key>"
        default y

config BOOL
        prompt "Cookie <name>=<key>"
        default n

endchoice

config STRING
        default "mcp_session"
        depends on COOKIE

config STRING
        default "/etc/sysrepo-mcp/keys"

config STRING
        default "mcp"

config STRING
        default "mcp:operators"

config BOOL
        default y

# =============================================================================
# ACCESS POLICY
# =============================================================================

config BOOL
        default n
        depends on ACL_ENABLED

config BOOL
        default y
        depends on ACL_ENABLED

config BOOL
        default y

config BOOL
        default n

config BOOL
        default n

config BOOL
        default n

config STRING
        default ""

# =============================================================================
# SYSREPO CONNECTION
# =============================================================================

config STRING
        default "/var/run/sysrepo-mcp.sock"

config STRING
        default "mcp"

config BOOL
        default y

# =============================================================================
# LOGGING (elog)
# =============================================================================

config BOOL
        default y

config INTEGER
        range 0 7
        default 6

config BOOL
        default n

config STRING
        default "/var/log/sysrepo-mcp.log"
        depends on !LOG_TO_SYSLOG

config BOOL
        default y
